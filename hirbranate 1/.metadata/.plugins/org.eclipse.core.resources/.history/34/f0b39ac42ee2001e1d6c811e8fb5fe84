package com.demo;

import java.util.List;

import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.Id;

import javax.persistence.OneToMany;


@Entity
public class QuestionOne {
	@Id
	@Column(name="question_id")
	private  int questionid;
	private String question;
	
	@OneToMany(mappedBy = "questionOne")
	private  List<AnswerOne> answerOnes;
	
	
	public int getQuestionid() {
		return questionid;
	}
	public void setQuestionid(int questionid) {
		this.questionid = questionid;
	}
	public String getQuestion() {
		return question;
	}
	public void setQuestion(String question) {
		this.question = question;
	}
	public List<AnswerOne> getAnsers() {
		return answerOnes;
	}
	public void setAnsers(List<AnswerOne> ansers) {
		this.answerOnes = ansers;
	}
	public QuestionOne(int questionid, String question, List<AnswerOne> ansers) {
		super();
		this.questionid = questionid;
		this.question = question;
		this.answerOnes = ansers;
	}
	public QuestionOne() {
		super();
		// TODO Auto-generated constructor stub
	}
	
	
	
}
